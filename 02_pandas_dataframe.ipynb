    "import pandas as pd\n",
    "data = {\n",
    "    \"Day\": [\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\"],\n",
    "    \"Temperature\": [30, 32, 29, 31, 33],\n",
    "    \"Humidity\": [65, 60, 80, 70, 55],\n",
    "    \"Rain\": [\"No\", \"No\", \"Yes\", \"No\", \"No\"]\n",
    "}\n",
    "weather = pd.DataFrame(data)\n",
    "print (weather)"
   ],
